10  REM  SSC BAUD TEST - ONE RATE PER RUN
20  REM  POWER-CYCLE THE PRINTER BETWEEN TRIES.
30  REM  FOR A TEST THAT CANNOT UPSET THE
40  REM  PRINTER AT ALL, USE RXWATCH INSTEAD.
50  D$ =  CHR$ (4):C$ =  CHR$ (9)
60  DIM BC(8),BN(8)
70  FOR I = 1 TO 8: READ BC(I),BN(I): NEXT I
80  HOME
90  PRINT "BAUD TEST - SLOT 2 - 8 DATA, NO PARITY"
100  PRINT
110  FOR I = 1 TO 8: PRINT I;" = ";BN(I);" BAUD": NEXT I
120  PRINT
130  PRINT "PICK 1-8, Q QUITS ";
140  GET A$: PRINT A$
150  IF A$ = "Q" THEN  END
160  N =  VAL (A$): IF N < 1 OR N > 8 THEN 130
170  PRINT D$;"PR#2"
180  PRINT C$; STR$ (BC(N));"B"
190  PRINT C$;"0D": PRINT C$;"0P": PRINT C$;"LE": PRINT C$;"XD": PRINT C$;"80N"
200  PRINT "<"; STR$ (BN(N));" BAUD> ABCDEFGH 12345678"
210  PRINT
220  PRINT D$;"PR#0"
230  PRINT : PRINT "SENT AT "; STR$ (BN(N));" BAUD."
240  PRINT "POWER-CYCLE BEFORE THE NEXT TRY."
250  PRINT : PRINT "PRESS A KEY";: GET A$
260  GOTO 80
270  DATA 3,110,5,150,6,300,7,600
280  DATA 8,1200,10,2400,12,4800,14,9600
