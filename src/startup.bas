10  REM  BOOT: CONFIGURE THE PRINTER, THEN MENU.
20  REM  THE SSC KEEPS THESE SETTINGS UNTIL THE
30  REM  APPLE IS RESET, SO AFTER BOOTING THIS
40  REM  DISK  PR#2 / LIST / PR#0  JUST WORKS.
50  D$ =  CHR$ (4):C$ =  CHR$ (9)
60  GOSUB 900
70  TEXT : HOME
80  PRINT "APPLE II SSC -> CENTRONICS GLP 3101"
90  PRINT "SERIAL TEST DISK - CARD IN SLOT 2"
100  PRINT
110  PRINT "PRINTER CONFIGURED: 9600 7-ODD-1"
120  PRINT "  PR#2 / LIST / PR#0  IS READY NOW"
130  PRINT
140  PRINT "1  LOOPBACK   TEST THE CARD BY ITSELF"
150  PRINT "2  FRAMING    FIND DATA/PARITY/STOP"
160  PRINT "3  BAUD       FIND THE BAUD RATE"
170  PRINT "4  SMOKETEST  FULL PRINTER TEST"
180  PRINT "5  RXWATCH    SHOW BYTES FROM PRINTER"
190  PRINT "6  DIRECT     PRINT WITHOUT THE FIRMWARE"
200  PRINT "7  STDTEST    NORMAL PR#2 PATH + TEST"
210  PRINT "8  PRSETUP    RE-SEND THE SETUP"
220  PRINT
230  PRINT "Q  QUIT TO BASIC"
240  PRINT
250  PRINT "CHOICE ";
260  GET A$
270  PRINT A$
280  IF A$ = "1" THEN  PRINT D$;"RUN LOOPBACK"
290  IF A$ = "2" THEN  PRINT D$;"RUN FRAMING"
300  IF A$ = "3" THEN  PRINT D$;"RUN BAUD"
310  IF A$ = "4" THEN  PRINT D$;"RUN SMOKETEST"
320  IF A$ = "5" THEN  PRINT D$;"RUN RXWATCH"
330  IF A$ = "6" THEN  PRINT D$;"RUN DIRECT"
340  IF A$ = "7" THEN  PRINT D$;"RUN STDTEST"
350  IF A$ = "8" THEN  GOSUB 900: GOTO 70
360  IF A$ = "Q" THEN  END
370  GOTO 70
900  REM  ---- CONFIGURE SSC IN SLOT 2 ----
910  PRINT D$;"PR#2"
920  PRINT C$;"14B": REM  9600 BAUD
930  PRINT C$;"1D": REM  7 DATA BITS, 1 STOP
940  PRINT C$;"1P": REM  ODD PARITY
950  PRINT C$;"LD": REM  PRINTER SW2-7 ADDS THE LF
960  PRINT C$;"2C": REM  250 MS PAUSE AFTER CR
970  PRINT C$;"80N": REM  80 COLUMNS
974  PRINT  CHR$ (27);"@";: REM  INITIALISE PRINTER
976  PRINT  CHR$ (27);"2": REM  1/6 IN - CR HERE IS DELIBERATE
980  PRINT D$;"PR#0"
990  RETURN
