10  REM  SSC FRAMING TEST - ONE SETTING PER RUN
20  REM  RUNNING ALL EIGHT IN ONE PASS IS NO GOOD:
30  REM  GARBAGE CAN PUT THE PRINTER INTO GRAPHICS
40  REM  MODE, AND THEN EVERY LATER TRY LOOKS BAD
50  REM  EVEN IF IT IS THE RIGHT ONE.
60  D$ =  CHR$ (4):C$ =  CHR$ (9)
70  HOME
80  PRINT "FRAMING TEST - SLOT 2 - 9600 BAUD"
90  PRINT
100  PRINT "POWER-CYCLE THE PRINTER BEFORE EACH"
110  PRINT "TRY. THIS MATTERS - SEE LINES 20-50."
120  PRINT
130  FOR I = 1 TO 8: READ F$,P$,T$: PRINT I;"  ";T$: NEXT I: RESTORE
140  PRINT
150  PRINT "PICK 1-8, Q QUITS ";
160  GET A$: PRINT A$
170  IF A$ = "Q" THEN  END
180  N =  VAL (A$): IF N < 1 OR N > 8 THEN 150
190  FOR I = 1 TO N: READ F$,P$,T$: NEXT I: RESTORE
200  PRINT D$;"PR#2"
210  PRINT C$;"14B": PRINT C$;"LD": PRINT C$;"XD": PRINT C$;"80N"
220  PRINT C$;F$: PRINT C$;P$
230  PRINT "<";T$;"> ABCDEFGH 12345678"
240  PRINT
250  PRINT C$;"0D": PRINT C$;"0P"
260  PRINT D$;"PR#0"
270  PRINT : PRINT "SENT: ";T$
280  PRINT "IF THAT WAS GARBAGE, POWER-CYCLE THE"
290  PRINT "PRINTER BEFORE THE NEXT TRY."
300  PRINT : PRINT "PRESS A KEY";: GET A$
310  GOTO 70
320  DATA "1D","1P","7 DATA ODD  1 STOP <-- CORRECT"
330  DATA "0D","3P","8 DATA EVEN 1 STOP"
340  DATA "1D","7P","7 DATA SPACE 1 STOP"
350  DATA "1D","3P","7 DATA EVEN 1 STOP"
360  DATA "4D","1P","8 DATA ODD  2 STOP"
370  DATA "0D","0P","8 DATA NONE 1 STOP"
380  DATA "4D","0P","8 DATA NONE 2 STOP"
390  DATA "0D","1P","8 DATA ODD  1 STOP"
