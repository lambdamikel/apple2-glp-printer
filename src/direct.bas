10  REM  DIRECT PRINT - NO SSC FIRMWARE
20  REM  FORMAT 3 = 8 DATA ODD PARITY = RIGHT.
30  REM  NO XON/XOFF - THE RECEIVER OVERRUNS
40  REM  AND STALE BYTES CAUSED FALSE STALLS.
50  REM  HARDWARE BUSY LINE ONLY, VIA H.
60  REM  ANY KEY ABORTS A PRINT IN PROGRESS.
70  SL = 2:B = 49288 + SL * 16
80  DIM CT(8),CM(8),F$(8),H$(4)
90  FOR I = 1 TO 8: READ CT(I),CM(I),F$(I): NEXT I
100  FOR I = 0 TO 4: READ H$(I): NEXT I
110  N = 3:LF = 0:DL = 20:CD = 1500:HS = 2
120  POKE B + 3,CT(N): POKE B + 2,CM(N)
130  HOME
140  S =  PEEK (B + 1)
150  PRINT "DIRECT - SLOT ";SL;" 9600 - STATUS ";S
160  FOR I = 1 TO 8: PRINT I;" ";F$(I);: IF I = N THEN  PRINT " <==";
170  PRINT : NEXT I
180  PRINT
190  PRINT "H  BUSY LINE: ";H$(HS)
200  PRINT "   DSR ";: IF (S AND 64) = 0 THEN  PRINT "READY";
210  IF (S AND 64) > 0 THEN  PRINT "BUSY ";
220  PRINT "   DCD ";: IF (S AND 32) = 0 THEN  PRINT "READY"
230  IF (S AND 32) > 0 THEN  PRINT "BUSY"
240  PRINT "W  WATCH BUSY LINES"
250  PRINT "L  LINE END: ";
260  IF LF = 1 THEN  PRINT "CR + LF"
270  IF LF = 0 THEN  PRINT "CR ONLY"
280  PRINT "+/- BYTE ";DL;"    ./, CR ";CD
290  PRINT "I  RESET   P  PRINT   Q  QUIT"
300  PRINT : PRINT "KEY ";
310  GET A$: PRINT A$
320  IF A$ = "Q" THEN  END
330  IF A$ = "H" THEN HS = HS + 1:HS = HS * (HS < 5): GOTO 120
340  IF A$ = "W" THEN  GOSUB 1100: GOTO 120
350  IF A$ = "L" THEN LF = 1 - LF: GOTO 120
360  IF A$ = "+" THEN DL = DL + 20: GOTO 120
370  IF A$ = "-" THEN DL = DL - 20:DL = DL * (DL > 0): GOTO 120
380  IF A$ = "." THEN CD = CD + 500: GOTO 120
390  IF A$ = "," THEN CD = CD - 500:CD = CD * (CD > 0): GOTO 120
400  IF A$ > "0" AND A$ < "9" THEN N =  VAL (A$): GOTO 120
410  IF A$ = "I" THEN  GOSUB 700: GOTO 120
420  IF A$ <  > "P" THEN 120
430  TC = 0:AB = 0
440  R =  PEEK (B):R =  PEEK (B): REM  FLUSH STALE INPUT
450  A$ = "AAAAAAAAAA": GOSUB 1000
460  IF AB = 0 THEN A$ = "BBBBBBBBBB": GOSUB 1000
470  IF AB = 0 THEN A$ = "CCCCCCCCCC": GOSUB 1000
480  PRINT : IF AB THEN  PRINT "ABORTED BY KEY."
490  PRINT "STATUS NOW "; PEEK (B + 1);"   TIMEOUTS ";TC
500  IF TC > 8 THEN  PRINT "MOSTLY BUSY - WRONG H, TRY THE NEXT"
505  IF TC > 0 AND TC < 9 THEN  PRINT "A FEW LONG WAITS - HANDSHAKE IS OK"
510  IF TC = 0 AND HS > 0 THEN  PRINT "HANDSHAKE PERFECT - LOWER CR WITH ,"
520  PRINT : PRINT "PRESS A KEY";: GET A$: GOTO 120
530  REM  ---- SEND ONE BYTE IN C ----
540  GOSUB 800
550  IF C > 127 THEN C = C - 128
560  POKE B,C
570  FOR W = 1 TO DL: NEXT W
580  RETURN
700  C = 27: GOSUB 540:C = 64: GOSUB 540
710  C = 27: GOSUB 540:C = 50: GOSUB 540
720  C = 13: GOSUB 540:C = 10: GOSUB 540
730  FOR W = 1 TO CD: NEXT W
740  RETURN
800  REM  WAIT FOR THE CHOSEN BUSY LINE
810  IF HS = 0 THEN  RETURN
820  T = 0
830  S =  PEEK (B + 1)
840  IF HS = 1 AND (S AND 64) = 0 THEN  RETURN
850  IF HS = 2 AND (S AND 64) > 0 THEN  RETURN
860  IF HS = 3 AND (S AND 32) = 0 THEN  RETURN
870  IF HS = 4 AND (S AND 32) > 0 THEN  RETURN
880  IF  PEEK (49152) > 127 THEN  POKE 49168,0:AB = 1: RETURN
890  T = T + 1: IF T < 6000 THEN 830
895  TC = TC + 1: RETURN
1000  REM  ---- SEND THE STRING IN A$ ----
1010  FOR J = 1 TO  LEN (A$)
1020  C =  ASC ( MID$ (A$,J,1)): GOSUB 540
1030  IF AB THEN J =  LEN (A$)
1040  NEXT J
1050  IF AB THEN  RETURN
1060  C = 13: GOSUB 540
1070  IF LF = 1 THEN C = 10: GOSUB 540
1080  FOR W = 1 TO CD: NEXT W
1090  RETURN
1100  HOME : PRINT "BUSY LINE WATCH - SLOT ";SL
1110  PRINT : PRINT "TAKE THE PRINTER OFF LINE, THEN ON."
1120  PRINT "PRESS A KEY TO STOP."
1130  S =  PEEK (B + 1)
1140  VTAB 7: HTAB 1: PRINT "STATUS ";S;"      "
1150  VTAB 8: HTAB 1: PRINT "DSR (PIN 20) ";
1160  IF (S AND 64) = 0 THEN  PRINT "0 READY         ";
1170  IF (S AND 64) > 0 THEN  PRINT "1 BUSY          ";
1180  VTAB 9: HTAB 1: PRINT "DCD (PIN  4) ";
1190  IF (S AND 32) = 0 THEN  PRINT "0 READY         ";
1200  IF (S AND 32) > 0 THEN  PRINT "1 BUSY          ";
1210  IF  PEEK (49152) < 128 THEN 1130
1220  POKE 49168,0: RETURN
1230  DATA 30,11,"8 DATA NO PARITY"
1240  DATA 30,235,"8 DATA SPACE PARITY"
1250  DATA 30,43,"8 DATA ODD PARITY"
1260  DATA 30,107,"8 DATA EVEN PARITY"
1270  DATA 30,171,"8 DATA MARK PARITY"
1280  DATA 62,235,"7 DATA SPACE PARITY"
1290  DATA 62,11,"7 DATA NO PARITY"
1300  DATA 62,43,"7 DATA ODD PARITY"
1310  DATA "NONE - DELAYS ONLY","DSR LOW = READY","DSR HIGH = READY"
1320  DATA "DCD LOW = READY","DCD HIGH = READY"
