10  REM  STANDARD PATH TEST - PR#2 AND PRINT
20  REM  IF THIS PRINTS CLEANLY, ORDINARY
30  REM  SOFTWARE WILL PRINT CLEANLY TOO.
40  REM  REQUIRES TWO PRINTER SWITCH CHANGES,
50  REM  SEE THE SCREEN BELOW.
60  D$ =  CHR$ (4):C$ =  CHR$ (9)
70  HOME
80  PRINT "STANDARD PRINTER SETUP - SLOT 2"
90  PRINT
100  PRINT "SET ON THE PRINTER FIRST:"
110  PRINT "  1-7  ON    (7 DATA BITS)"
115  PRINT "  1-3 1-4 1-5 ALL ON (9600 BAUD)"
120  PRINT "  1-1  LEAVE AS SHIPPED - DO NOT FLIP"
130  PRINT "LEAVE ALONE:"
140  PRINT "  1-8  OFF   (SERIAL)"
150  PRINT "  1-6  ON    (ODD PARITY)"
160  PRINT "  2-7  ON    (PRINTER ADDS THE LF)"
170  PRINT "POWER THE PRINTER OFF AND ON."
180  PRINT
190  SL = 2:B = 49288 + SL * 16:S =  PEEK (B + 1)
192  PRINT "6551 STATUS ";S;
194  IF (S AND 64) = 0 THEN  PRINT "  DSR OK"
196  IF (S AND 64) > 0 THEN  PRINT "  DSR NOT ASSERTED"
198  IF (S AND 64) > 0 THEN  PRINT "*** THE FIRMWARE WILL HANG. FLIP 1-1"
199  IF (S AND 64) > 0 THEN  PRINT "*** BACK, OR CTRL-RESET TO ESCAPE."
201  PRINT : PRINT "PRESS A KEY TO PRINT";: GET A$
202  PRINT D$;"PR#2"
210  PRINT C$;"14B": REM  9600 BAUD
220  PRINT C$;"1D": REM  7 DATA BITS, 1 STOP
230  PRINT C$;"1P": REM  ODD PARITY
240  PRINT C$;"LD": REM  PRINTER SW2-7 SUPPLIES THE LF
250  PRINT C$;"2C": REM  250 MS PAUSE AFTER CR
260  PRINT C$;"80N": REM  80 COLUMNS
264  PRINT  CHR$ (27);"@";: REM  INITIALISE PRINTER
266  PRINT  CHR$ (27);"2";: REM  1/6 INCH LINE SPACING
270  PRINT "STANDARD PATH - PR#2 AND PLAIN PRINT"
280  PRINT "AAAAAAAAAAAAAAAAAAAA"
290  PRINT "BBBBBBBBBBBBBBBBBBBB"
300  PRINT "CCCCCCCCCCCCCCCCCCCC"
310  PRINT "0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ"
320  PRINT D$;"PR#0"
330  HOME
340  PRINT "DONE."
350  PRINT
360  PRINT "CLEAN? THEN ORDINARY SOFTWARE WORKS."
370  PRINT "THE SSC HOLDS THESE SETTINGS UNTIL THE"
380  PRINT "APPLE IS RESET, SO RUN THIS ONCE AFTER"
390  PRINT "EACH BOOT AND FORGET ABOUT IT."
400  PRINT
410  PRINT "GRAPHICS CHARACTERS -> 1-7 NOT ON YET"
420  PRINT "MISSING CHARACTERS  -> RAISE THE CR"
430  PRINT "   PAUSE: CHANGE 2C TO 3C IN LINE 250"
440  PRINT "FROZE               -> 1-1 IS FLIPPED."
450  PRINT "   PUT IT BACK AS SHIPPED."
455  PRINT "NOTHING, NO FREEZE  -> 1-7 MAY NOT BE ON"
460  END
