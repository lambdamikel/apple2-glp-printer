10  REM  PRSETUP - CONFIGURE SSC IN SLOT 2 FOR
20  REM  THE CENTRONICS GLP 3101.
30  REM  RUN ONCE AFTER BOOT. THE SSC KEEPS
40  REM  THESE UNTIL THE APPLE IS RESET, SO ALL
50  REM  LATER PR#2 FROM ANY PROGRAM INHERITS
60  REM  THEM - INCLUDING LIST.
70  D$ =  CHR$ (4):C$ =  CHR$ (9)
80  PRINT D$;"PR#2"
90  PRINT C$;"14B": REM  9600 BAUD
100  PRINT C$;"1D": REM  7 DATA BITS, 1 STOP
110  PRINT C$;"1P": REM  ODD PARITY
120  PRINT C$;"LD": REM  PRINTER SW2-7 SUPPLIES THE LF
130  PRINT C$;"2C": REM  250 MS PAUSE AFTER CR
140  PRINT C$;"80N": REM  80 COLUMNS
144  PRINT  CHR$ (27);"@";: REM  INITIALISE PRINTER
146  PRINT  CHR$ (27);"2": REM  1/6 IN - CR HERE IS DELIBERATE
150  PRINT D$;"PR#0"
160  PRINT "PRINTER READY.  PR#2 / LIST / PR#0"
170  END
