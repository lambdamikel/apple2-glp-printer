10  REM  SSC LOOPBACK TEST - SLOT 2
20  REM  ---------------------------------------
30  REM  UNPLUG THE PRINTER. SHORT PIN 2 TO PIN 3
40  REM  ON THE SSC DB-25 (PAPERCLIP IS FINE).
50  REM  TALKS TO THE 6551 DIRECTLY - NO FIRMWARE,
60  REM  NO PR#, NO PRINTER INVOLVED.
70  REM  ---------------------------------------
80  SL = 2:B = 49288 + SL * 16
90  POKE B + 3,30: REM  CTRL: 9600 BAUD, 8 DATA, 1 STOP
100  POKE B + 2,11: REM  CMD: NO PARITY, DTR + RTS ON
110  R =  PEEK (B): REM  FLUSH RECEIVER
120  OK = 0:BAD = 0
130  FOR C = 65 TO 74
140  POKE B,C
150  S = 0
160  FOR W = 1 TO 800:S =  PEEK (B + 1)
170  IF S AND 8 THEN W = 800
180  NEXT W
190  IF (S AND 8) = 0 THEN  PRINT  CHR$ (C);" TIMEOUT  STATUS=";S:BAD = BAD + 1: GOTO 230
200  R =  PEEK (B)
210  IF R = C THEN  PRINT  CHR$ (C);" OK":OK = OK + 1: GOTO 230
220  PRINT  CHR$ (C);" -> ";R;" MISMATCH":BAD = BAD + 1
230  NEXT C
240  PRINT : PRINT "OK=";OK;"   BAD=";BAD
250  IF OK = 10 THEN  PRINT "CARD TRANSMITS AND RECEIVES. NOT THE CARD."
260  IF BAD > 0 THEN  PRINT "NO LOOPBACK: CHECK THE 2-3 JUMPER FIRST."
270  END
