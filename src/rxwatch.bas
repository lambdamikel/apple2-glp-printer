10  REM  RXWATCH - BYTES ARRIVING FROM PRINTER
20  REM  READS THE 6551 DIRECTLY AND SENDS
30  REM  NOTHING, SO IT CANNOT UPSET THE
40  REM  PRINTER. THIS IS THE SAFE WAY TO FIND
50  REM  THE BAUD RATE.
60  SL = 2:B = 49288 + SL * 16
70  DIM BC(8),BN(8)
80  FOR I = 1 TO 8: READ BC(I),BN(I): NEXT I
90  N = 8: GOSUB 400
100  HOME
110  PRINT "RXWATCH - SLOT ";SL
120  PRINT "KEYS 1-8 PICK BAUD.  Q QUITS."
130  PRINT "1=110  2=150  3=300  4=600"
140  PRINT "5=1200 6=2400 7=4800 8=9600"
150  PRINT
160  PRINT "TAKE THE PRINTER OFF LINE, THEN ON."
170  PRINT "A CLEAN 17 OR 19 MEANS THIS BAUD"
180  PRINT "RATE MATCHES THE PRINTER."
190  GOSUB 420
200  K =  PEEK (49152)
210  IF K < 128 THEN 260
220  POKE 49168,0:K = K - 128
230  IF K = 81 OR K = 113 THEN  END
240  IF K > 48 AND K < 57 THEN N = K - 48: GOSUB 400: GOSUB 420
260  S =  PEEK (B + 1)
270  IF (S AND 8) = 0 THEN 200
280  R =  PEEK (B)
290  PRINT R;
300  IF R = 17 THEN  PRINT "=XON";
310  IF R = 19 THEN  PRINT "=XOFF";
320  IF R > 31 AND R < 127 THEN  PRINT "="; CHR$ (R);
330  PRINT " ";
340  GOTO 200
400  POKE B + 3,16 + BC(N): POKE B + 2,11:R =  PEEK (B): RETURN
420  PRINT : PRINT "--- NOW AT ";BN(N);" BAUD ---": RETURN
430  DATA 3,110,5,150,6,300,7,600
440  DATA 8,1200,10,2400,12,4800,14,9600
